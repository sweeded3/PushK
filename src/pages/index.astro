---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
const base = import.meta.env.BASE_URL;
const asset = (path) => `${base}assets/${path}`;

const services = [
  {
    title: "Комплексный уход для собак",
    text: "Стрижка, купание, сушка, уход за ушами и когтями",
    price: "от 2400 ₽",
    image: asset("toy-dog.jpg")
  },
  {
    title: "Комплексный уход для кошек",
    text: "Полный комплекс ухода для питомца",
    price: "от 2400 ₽",
    image: asset("shiba-fur.jpg")
  },
  {
    title: "Гигиенический уход SPA",
    text: "Стрижка, купание, сушка, чистка ушей и когтей",
    price: "от 2200 ₽",
    image: asset("black-after.jpg")
  },
  {
    title: "Дополнительные услуги",
    text: "Стрижка когтей, чистка ушек, экспресс-уход",
    price: "от 300 ₽",
    image: asset("corgi-play.jpg")
  }
];

const gallery = [
  { before: asset("pomeranian-before.jpg"), after: asset("toy-dog.jpg"), label: "Шпиц" },
  { before: asset("chihuahua-before-1.jpg"), after: asset("chihuahua-after-1.jpg"), label: "Мини-порода" },
  { before: asset("black-before.jpg"), after: asset("black-after.jpg"), label: "Форма" }
];

const benefits = [
  { icon: "🛡", title: "Профессиональные грумеры", text: "Опыт и регулярное обучение" },
  { icon: "🧴", title: "Премиальная косметика", text: "Безопасные средства для чувствительной кожи" },
  { icon: "♡", title: "Индивидуальный подход", text: "Учитываем характер и особенности питомца" },
  { icon: "📷", title: "Фото- и видеоотчет", text: "Красивые кадры после процедуры" },
  { icon: "🛁", title: "Комфортная атмосфера", text: "Чисто, уютно и без стресса" }
];

const reviews = [
  { name: "Анна и Молли", text: "Спасибо за потрясающий уход! Молли всегда рада сюда приходить, выглядит счастливой и такой красивой.", image: asset("toy-dog.jpg"), date: "12 мая 2024" },
  { name: "Сергей и Барни", text: "Отличный салон, профессиональные мастера и внимательное отношение. Видно, как любят после каждого визита.", image: asset("corgi-play.jpg"), date: "8 мая 2024" },
  { name: "Мария и Луна", text: "Очень любим «Пушистый Контур»! Всегда чисто, уютно и с заботой о питомцах.", image: asset("black-after.jpg"), date: "3 мая 2024" }
];

const steps = [
  "Выберите услугу и удобное время",
  "Оставьте заявку на сайте или по телефону",
  "Мы подтверждаем запись и напоминаем о визите",
  "Приезжайте и наслаждайтесь результатом"
];
---
<BaseLayout>
  <div id="top" class="page-shell">
    <Header />

    <main id="content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <div class="place-badges" aria-label="Награды Яндекс Карт">
              <span>Яндекс Хорошее место 2025</span>
              <span>Яндекс Хорошее место 2026</span>
            </div>

            <h1 id="hero-title">Профессиональный уход с любовью к вашему питомцу</h1>
            <p class="lead">Груминг-салон «Пушистый Контур» — чистота, комфорт и забота в каждой детали.</p>

            <div class="hero-actions" aria-label="Основные действия">
              <a class="btn btn-primary" href="#contact">Записаться онлайн <span aria-hidden="true">▣</span></a>
              <a class="btn btn-secondary" href="#services">Наши услуги</a>
            </div>
          </div>

          <div class="hero-media" aria-label="Пудель до и после груминга">
            <img class="hero-dog" src={asset("hero-before-after.png")} alt="Пудель до и после груминга" loading="eager" />
          </div>
        </div>

        <div class="container trust-strip" aria-label="Преимущества">
          <div class="trust-item"><span>🐾</span>Опытные грумеры с любовью к животным</div>
          <div class="trust-item"><span>🛡</span>Безопасные и гипоаллергенные средства</div>
          <div class="trust-item"><span>♡</span>Индивидуальный подход к каждому питомцу</div>
        </div>
      </section>

      <section id="services" class="section" aria-labelledby="services-title">
        <div class="container">
          <div class="section-head section-head-row">
            <h2 id="services-title">Наши Услуги</h2>
            <a href="#contact">Смотреть все услуги →</a>
          </div>

          <div class="service-grid">
            {services.map((service) => (
              <article class="service-card">
                <img src={service.image} alt={service.title} loading="lazy" />
                <div class="service-body">
                  <h3>{service.title}</h3>
                  <p>{service.text}</p>
                  <div class="service-bottom">
                    <strong>{service.price}</strong>
                    <span aria-hidden="true">🐾</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section promo-section" aria-label="Скидка на первое посещение">
        <div class="container promo-banner" style={`--promo-bg: url('${asset("banner-poodle-real.jpg")}')`}>
          <div class="promo-copy">
            <span class="promo-icon">🎁</span>
            <h2>Скидка на первое посещение 10%</h2>
            <p>Скидка на первый груминг щенков 15% и специальные условия для заводчиков.</p>
            <a class="btn btn-accent" href="#contact">Получить скидку</a>
          </div>
        </div>
      </section>

      <section id="gallery" class="section" aria-labelledby="gallery-title">
        <div class="container">
          <div class="section-head section-head-row">
            <h2 id="gallery-title">До и после</h2>
            <a href="#contact">Смотреть галерею →</a>
          </div>

          <div class="before-after-grid">
            {gallery.map((item) => (
              <article class="before-after-card">
                <div class="pair">
                  <div>
                    <img src={item.before} alt={`${item.label} до груминга`} loading="lazy" />
                    <span>До</span>
                  </div>
                  <div>
                    <img src={item.after} alt={`${item.label} после груминга`} loading="lazy" />
                    <span>После</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="section why-section" aria-labelledby="benefits-title">
        <div class="container">
          <div class="section-head section-head-center">
            <h2 id="benefits-title">Почему выбирают нас</h2>
          </div>

          <div class="benefit-grid">
            {benefits.map((benefit) => (
              <article>
                <span class="benefit-icon">{benefit.icon}</span>
                <strong>{benefit.title}</strong>
                <p>{benefit.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="reviews" class="section" aria-labelledby="reviews-title">
        <div class="container">
          <div class="section-head section-head-row">
            <h2 id="reviews-title">Отзывы наших клиентов</h2>
            <a href="#contact">Смотреть все отзывы →</a>
          </div>

          <div class="review-grid">
            {reviews.map((review) => (
              <article class="review-card">
                <div class="review-top">
                  <div class="avatar">★</div>
                  <div>
                    <strong>{review.name}</strong>
                    <div class="stars" aria-label="Оценка 5 из 5">★★★★★</div>
                  </div>
                </div>
                <p>{review.text}</p>
                <div class="review-bottom">
                  <small>{review.date}</small>
                  <img src={review.image} alt="Питомец клиента после груминга" loading="lazy" />
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section steps-section" aria-labelledby="steps-title">
        <div class="container steps-layout">
          <div>
            <div class="section-head">
              <h2 id="steps-title">Как записаться</h2>
            </div>

            <div class="step-grid">
              {steps.map((step, index) => (
                <article class="step-card">
                  <span aria-hidden="true">{index + 1}</span>
                  <p>{step}</p>
                </article>
              ))}
            </div>
          </div>

          <aside id="contact" class="contact-card" aria-labelledby="contact-title" style={`--contact-bg: url('${asset("toy-dog.jpg")}')`}>
            <h2 id="contact-title">Позаботьтесь о своём питомце уже сегодня</h2>
            <a class="btn btn-accent" href="tel:+79991234567">Записаться онлайн ▣</a>
            <p>или позвоните нам</p>
            <strong><a href="tel:+79991234567">+7 (999) 123-45-67</a></strong>
          </aside>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>